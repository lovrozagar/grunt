{
  "name": "@lovrozagar/grunt",
  "version": "0.11.2",
  "description": "Multi-agent orchestrator SoT — deep-merge rulesync trees, product scripts, and generate pipeline into a consumer repo",
  "keywords": [
    "agents",
    "grunt",
    "orchestrator",
    "rulesync"
  ],
  "homepage": "https://github.com/lovrozagar/grunt#readme",
  "bugs": {
    "url": "https://github.com/lovrozagar/grunt/issues"
  },
  "license": "MIT",
  "author": "lovrozagar",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovrozagar/grunt.git"
  },
  "bin": {
    "grunt": "./bin/grunt.js"
  },
  "files": [
    "bin/grunt.js",
    "cli",
    ".rulesync",
    "!.rulesync/scripts/**/*.test.ts",
    "!.rulesync/scripts/fixtures",
    ".grok",
    ".codex",
    ".claude",
    ".agents",
    "AGENTS.md",
    "CLAUDE.md",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cross-spawn": "^7.0.6",
    "smol-toml": "^1.8.0"
  },
  "scripts": {
    "rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
    "rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
    "rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
    "hooks:union": "node .rulesync/scripts/hooks-union.mjs",
    "hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
    "doctor": "node ./.rulesync/scripts/doctor.mjs",
    "setup": "node ./.rulesync/scripts/setup.mjs",
    "rulesync:doctor": "rulesync doctor",
    "sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
    "sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
    "sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
    "purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
    "purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
    "antigravity": "antigravity --dangerously-skip-permissions",
    "claude": "claude --dangerously-skip-permissions",
    "codex": "codex --dangerously-bypass-approvals-and-sandbox",
    "gemini": "gemini --yolo",
    "grok": "grok --yolo",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "rulesync": "16.17.0",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "verdaccio": "^6.10.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
